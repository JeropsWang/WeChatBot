{
  "name": "wechatbot",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/server/main.ts\" \"npm --prefix apps/web run dev -- --host 127.0.0.1 --port 4311 --strictPort\"",
    "start": "tsx apps/server/main.ts",
    "build": "npm run typecheck && npm --prefix apps/web run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bridge": "node scripts/python.mjs -m unittest discover -s bridge/tests -v",
    "db:migrate": "tsx apps/server/migrate.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose stop",
    "bridge:diagnose": "node scripts/python.mjs bridge/main.py diagnose",
    "bridge": "node scripts/python.mjs bridge/main.py run",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@mozilla/readability": "0.6.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "bullmq": "6.4.2",
    "concurrently": "10.0.6",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "linkedom": "0.18.14",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unpdf": "1.9.1",
    "vitest": "5.0.5",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
